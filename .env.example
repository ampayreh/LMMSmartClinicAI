# Supabase (auto-injected in Edge Functions; only needed for local dev)
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# AWS Bedrock (set as Supabase secrets for the Edge Function)
# supabase secrets set AWS_ACCESS_KEY_ID=xxx AWS_SECRET_ACCESS_KEY=xxx AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# Model IDs (optional — defaults are set in the Edge Function)
# ROUTER_MODEL="us.anthropic.claude-haiku-4-5-20251001-v1:0"
# MAIN_MODEL="us.anthropic.claude-sonnet-4-20250514-v1:0"

# Bedrock Guardrails (optional — guardrails are skipped if not set)
# Create via: aws bedrock create-guardrail ... (see scripts/create-guardrail.sh)
# BEDROCK_GUARDRAIL_ID=""
# BEDROCK_GUARDRAIL_VERSION="DRAFT"
